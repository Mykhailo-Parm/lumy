<Application
    x:Class="Lumy.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="LikeBrush" Color="#FFFF5A7A" />
            <SolidColorBrush x:Key="SuperLikeBrush" Color="#FFFFC23D" />
            <SolidColorBrush x:Key="RejectBrush" Color="#FF9AA0A6" />
            <SolidColorBrush x:Key="LoupeBackgroundBrush" Color="#FF0B0B0C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
