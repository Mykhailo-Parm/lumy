<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lumy.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lumy.App"
    Title="Lumy">

    <Grid x:Name="RootGrid" PreviewKeyDown="RootGrid_PreviewKeyDown" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the window draws its own so the app reads as one surface on Mica. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="18" Height="18" />
                <TextBlock Text="Lumy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="FolderTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="1" Padding="12,4,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <SplitButton x:Name="OpenFolderButton" Click="OpenFolderButton_Click" ToolTipService.ToolTip="Открыть папку (Ctrl+O); стрелка — недавние папки">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="16" />
                        <TextBlock Text="Открыть папку" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="RecentFoldersMenu" Placement="BottomEdgeAlignedLeft" />
                    </SplitButton.Flyout>
                </SplitButton>
                <Button Click="Tournament_Click" ToolTipService.ToolTip="Турнир: выбрать лучшие N фото попарно (B)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C1;" FontSize="16" />
                        <TextBlock Text="Турнир" />
                    </StackPanel>
                </Button>
                <DropDownButton ToolTipService.ToolTip="Альбомы: подборки для каруселей и сторис, без копирования файлов">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                        <TextBlock Text="Альбомы" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="AlbumsMenu" Placement="BottomEdgeAlignedLeft" Opening="AlbumsMenu_Opening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Click="Export_Click" ToolTipService.ToolTip="Экспорт JPEG для Instagram (Ctrl+E)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDE1;" FontSize="16" />
                        <TextBlock Text="Экспорт" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <SelectorBar x:Name="FilterBar" Grid.Column="1" SelectionChanged="FilterBar_SelectionChanged">
                <SelectorBarItem Text="Все" Tag="All" IsSelected="True" ToolTipService.ToolTip="Ctrl+0" />
                <SelectorBarItem Text="Лайки" Tag="LikedOrBetter" ToolTipService.ToolTip="Лайки и суперлайки (Ctrl+1)" />
                <SelectorBarItem Text="Суперлайки" Tag="SuperLikes" ToolTipService.ToolTip="Ctrl+2" />
                <SelectorBarItem Text="Без оценки" Tag="Unrated" ToolTipService.ToolTip="Ctrl+3" />
                <SelectorBarItem Text="Отклонённые" Tag="Rejected" ToolTipService.ToolTip="Ctrl+4" />
            </SelectorBar>

            <ComboBox x:Name="SortBox" Grid.Column="2" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" MinWidth="170">
                <ComboBoxItem Content="По времени съёмки" Tag="CaptureTime" />
                <ComboBoxItem Content="По имени" Tag="Name" />
            </ComboBox>

            <TextBlock x:Name="CounterText" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTipService.ToolTip="Размер миниатюр (Ctrl + колесо)">
                <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Slider x:Name="SizeSlider" Width="140" Minimum="120" Maximum="420" StepFrequency="10" ValueChanged="SizeSlider_ValueChanged" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="5" Click="Remote_Click" ToolTipService.ToolTip="Пульт: управлять Lumy с телефона">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8EA;" FontSize="16" />
                    <TextBlock x:Name="RemoteButtonText" Text="Телефон" />
                </StackPanel>
            </Button>

            <Button Grid.Column="6" Click="Help_Click" ToolTipService.ToolTip="Клавиши (?)">
                <FontIcon Glyph="&#xE765;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Gallery -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Shown while an album is open instead of a folder. -->
            <Grid x:Name="AlbumBar" Grid.Row="0" Visibility="Collapsed" Margin="16,0,16,8" Padding="14,8" ColumnSpacing="12" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8F1;" FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AlbumTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AlbumHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Экспорт альбома" Style="{StaticResource AccentButtonStyle}" Click="AlbumExport_Click" />
                    <Button Content="Переименовать" Click="AlbumRename_Click" />
                    <Button Content="Удалить альбом" Click="AlbumDelete_Click" />
                    <Button Click="AlbumClose_Click" ToolTipService.ToolTip="Вернуться к папке">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <GridView
                x:Name="Gallery"
                Grid.Row="1"
                Padding="12,0,12,12"
                DragItemsCompleted="Gallery_DragItemsCompleted"
                SelectionMode="Extended"
                IsItemClickEnabled="False"
                ContainerContentChanging="Gallery_ContainerContentChanging"
                DoubleTapped="Gallery_DoubleTapped"
                PointerWheelChanged="Gallery_PointerWheelChanged"
                ContextRequested="Gallery_ContextRequested">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="200" ItemHeight="200" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:PhotoItem">
                        <Grid CornerRadius="6" Margin="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="{x:Bind FileName}">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" Opacity="{x:Bind ImageOpacity, Mode=OneWay}" />
                            <Border Visibility="{x:Bind TierBadgeVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                    Padding="5" CornerRadius="12" Background="#99000000">
                                <FontIcon Glyph="{x:Bind TierGlyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind TierBrush, Mode=OneWay}" />
                            </Border>
                            <Border Visibility="{x:Bind EditVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                    Padding="5" CornerRadius="12" Background="#99000000"
                                    ToolTipService.ToolTip="{x:Bind EditSummary, Mode=OneWay}">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                            </Border>
                            <Border Visibility="{x:Bind SeriesBadgeVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                    Padding="6,2" CornerRadius="8" Background="#99000000"
                                    ToolTipService.ToolTip="Серия похожих кадров">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="11" />
                                    <TextBlock Text="{x:Bind SeriesBadgeText, Mode=OneWay}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE91B;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Откройте папку с фотосессией" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Ctrl+O или перетащите папку в окно" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <Button Content="Открыть папку" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OpenFolder_Click" />
            </StackPanel>

            <ProgressRing x:Name="LoadingRing" Grid.Row="1" IsActive="False" Width="48" Height="48" />
        </Grid>

        <!-- Full-screen viewer, drawn over everything below the title bar: info bar, photo, filmstrip. -->
        <Grid x:Name="Loupe" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource LoupeBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar: rating buttons, name, shooting details, position -->
            <Grid Grid.Row="0" Padding="12,6,16,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="LoupeRejectButton" Click="LoupeReject_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Отказ (X). Ещё раз, чтобы снять">
                        <FontIcon x:Name="LoupeRejectIcon" Glyph="&#xE8E0;" FontSize="18" />
                    </Button>
                    <Button x:Name="LoupeLikeButton" Click="LoupeLike_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Лайк (F или 1). Ещё раз, чтобы снять">
                        <FontIcon x:Name="LoupeLikeIcon" Glyph="&#xEB51;" FontSize="18" />
                    </Button>
                    <Button x:Name="LoupeSuperButton" Click="LoupeSuper_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Суперлайк (R или 2). Ещё раз, чтобы снять">
                        <FontIcon x:Name="LoupeSuperIcon" Glyph="&#xE734;" FontSize="18" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="LoupeName" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="LoupeDetails" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LoupePosition" Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                    <Button Click="LoupeEdit_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Кроп и цвет для Instagram (E)">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                    </Button>
                    <Button Click="FilmstripToggle_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Показать или скрыть ленту (T)">
                        <FontIcon x:Name="FilmstripToggleIcon" Glyph="&#xE70D;" FontSize="14" />
                    </Button>
                    <Button Click="LoupeMore_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Ещё: копировать, показать в проводнике, открыть в…">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                    </Button>
                    <Button Click="LoupeClose_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="В галерею (Esc)">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The photo: centred, fitted to the space between the bars; Ctrl + wheel or Z zooms, drag pans. -->
            <ScrollViewer
                x:Name="LoupeScroll"
                Grid.Row="1"
                ZoomMode="Enabled"
                MinZoomFactor="1"
                MaxZoomFactor="16"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Hidden"
                SizeChanged="LoupeScroll_SizeChanged"
                DoubleTapped="LoupeScroll_DoubleTapped"
                ContextRequested="LoupeScroll_ContextRequested">
                <Grid x:Name="LoupeCanvas" Background="Transparent">
                    <Image x:Name="LoupeImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </ScrollViewer>

            <!-- Flash shown for a moment after rating, so a key press visibly lands. -->
            <Border x:Name="FlashBadge" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" CornerRadius="60"
                    Background="#88000000" Opacity="0" IsHitTestVisible="False">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.18" />
                </Border.OpacityTransition>
                <FontIcon x:Name="FlashIcon" FontSize="64" />
            </Border>

            <!-- Filmstrip: the wheel over it scrolls the strip only; a click opens that photo. -->
            <Grid x:Name="FilmstripPanel" Grid.Row="2" Background="#FF111113">
                <ListView
                    x:Name="Filmstrip"
                    Height="96"
                    Padding="8,6"
                    SelectionMode="Extended"
                    SelectionChanged="Filmstrip_SelectionChanged"
                    ContainerContentChanging="Filmstrip_ContainerContentChanging"
                    ContextRequested="Filmstrip_ContextRequested"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.IsHorizontalRailEnabled="True">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PhotoItem">
                            <Grid Width="{StaticResource FilmstripItemWidth}" Height="80" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" Opacity="{x:Bind ImageOpacity, Mode=OneWay}" />
                                <Border Visibility="{x:Bind TierBadgeVisibility, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="3" Padding="3" CornerRadius="8" Background="#99000000">
                                    <FontIcon Glyph="{x:Bind TierGlyph, Mode=OneWay}" FontSize="10" Foreground="{x:Bind TierBrush, Mode=OneWay}" />
                                </Border>
                                <!-- Picked for comparing (Ctrl/Shift + click) -->
                                <Border Visibility="{x:Bind PickedVisibility, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="3" Width="18" Height="18" CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <!-- The photo open right now -->
                                <Border Visibility="{x:Bind CurrentVisibility, Mode=OneWay}" BorderThickness="3" CornerRadius="4"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Swipe mode: one card at a time, a decision per card. -->
        <Grid x:Name="SwipeView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource LoupeBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="20,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Свайп" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar x:Name="SwipeProgressBar" Grid.Column="1" VerticalAlignment="Center" Minimum="0" />
                <TextBlock x:Name="SwipeProgressText" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="3" Click="SwipeClose_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Выйти из свайпа (Esc)">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                </Button>
            </Grid>

            <Grid x:Name="SwipeStage" Grid.Row="1" Margin="24,0">
                <Image x:Name="SwipeNextImage" Stretch="Uniform" Opacity="0.35" />
                <Grid x:Name="SwipeCard" Background="Transparent" RenderTransformOrigin="0.5,0.5"
                      ManipulationMode="TranslateX,TranslateY"
                      ManipulationDelta="SwipeCard_ManipulationDelta"
                      ManipulationCompleted="SwipeCard_ManipulationCompleted">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="SwipeTransform" />
                    </Grid.RenderTransform>
                    <Image x:Name="SwipeImage" Stretch="Uniform" />
                    <Border x:Name="SwipeHint" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" CornerRadius="60"
                            Background="#88000000" Opacity="0" IsHitTestVisible="False">
                        <FontIcon x:Name="SwipeHintIcon" FontSize="72" />
                    </Border>
                </Grid>
                <TextBlock x:Name="SwipeSeriesText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel x:Name="SwipeSummary" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <TextBlock Text="Готово" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SwipeSummaryText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="Ещё раз по лайкам" Click="SwipeAgainLikes_Click" />
                        <Button Content="Показать лайки" Click="SwipeShowLikes_Click" />
                        <Button Content="В галерею" Style="{StaticResource AccentButtonStyle}" Click="SwipeClose_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,12,0,20">
                <Button Click="SwipeBack_Click" ToolTipService.ToolTip="Назад (Backspace)" Width="48" Height="48" CornerRadius="24">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                </Button>
                <Button Click="SwipeReject_Click" ToolTipService.ToolTip="Отказ (←), Shift+← вся серия" Width="64" Height="64" CornerRadius="32">
                    <FontIcon Glyph="&#xE8E0;" FontSize="22" Foreground="{StaticResource RejectBrush}" />
                </Button>
                <Button Click="SwipeSkip_Click" ToolTipService.ToolTip="Решу потом (↓)" Width="48" Height="48" CornerRadius="24">
                    <FontIcon Glyph="&#xE74B;" FontSize="16" />
                </Button>
                <Button Click="SwipeSuper_Click" ToolTipService.ToolTip="Суперлайк (↑)" Width="64" Height="64" CornerRadius="32">
                    <FontIcon Glyph="&#xE735;" FontSize="22" Foreground="{StaticResource SuperLikeBrush}" />
                </Button>
                <Button Click="SwipeLike_Click" ToolTipService.ToolTip="Лайк (→)" Width="64" Height="64" CornerRadius="32">
                    <FontIcon Glyph="&#xEB52;" FontSize="22" Foreground="{StaticResource LikeBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Compare: 2 to 9 photos side by side, zoom and pan in sync. -->
        <Grid x:Name="CompareView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource LoupeBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="20,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Сравнение" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="CompareInfo" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="2" Click="CompareClose_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Выйти из сравнения (Esc)">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                </Button>
            </Grid>
            <Grid x:Name="CompareGrid" Grid.Row="1" Margin="8,0" SizeChanged="CompareGrid_SizeChanged" />

            <!-- Overlay: two frames on top of each other, a wipe or a fade between them, to catch small differences. -->
            <Grid x:Name="OverlayStage" Grid.Row="1" Margin="8,0" Visibility="Collapsed" Background="Transparent"
                  PointerMoved="OverlayStage_PointerMoved" PointerPressed="OverlayStage_PointerPressed" PointerWheelChanged="OverlayStage_PointerWheelChanged"
                  PointerReleased="OverlayStage_PointerReleased" PointerCaptureLost="OverlayStage_PointerCaptureLost"
                  SizeChanged="OverlayStage_SizeChanged">
                <Image x:Name="OverlayBottom" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="OverlayTop" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" SizeChanged="OverlayStage_SizeChanged" />
                <Canvas x:Name="OverlayMarks" IsHitTestVisible="False">
                    <Rectangle x:Name="OverlaySplit" Width="2" Fill="White" Opacity="0.9" />
                </Canvas>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="10,4" CornerRadius="8" Background="#99000000" IsHitTestVisible="False">
                    <TextBlock x:Name="OverlayLeftName" FontSize="12" />
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="10,4" CornerRadius="8" Background="#99000000" IsHitTestVisible="False">
                    <TextBlock x:Name="OverlayRightName" FontSize="12" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,14" Spacing="8">
                <StackPanel x:Name="OverlayBar" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Visibility="Collapsed">
                    <ToggleButton x:Name="OverlayWipeButton" Content="Шторка" Click="OverlayWipe_Click" />
                    <ToggleButton x:Name="OverlayFadeButton" Content="Прозрачность" Click="OverlayFade_Click" />
                    <Slider x:Name="OverlaySlider" Width="260" Minimum="0" Maximum="1" StepFrequency="0.01" VerticalAlignment="Center" ValueChanged="OverlaySlider_ValueChanged" />
                    <Button Content="Поменять местами" Click="OverlaySwap_Click" />
                </StackPanel>
                <TextBlock x:Name="CompareHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="Наведи на фото: F лайк  ·  R суперлайк  ·  X отказ (ещё раз — снять)  ·  1–9 убрать  ·  двойной клик или Ctrl+колесо — зум, мышью — сдвиг  ·  L синхронно  ·  O наложение  ·  Esc назад" />
            </StackPanel>
        </Grid>

        <!-- Tournament: two photos, pick the better one; at the end, the winners in order. -->
        <Grid x:Name="TournamentView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource LoupeBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="20,10" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Турнир" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="TournamentStageText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="TournamentProgress" Minimum="0" Maximum="1" />
                </StackPanel>
                <TextBlock x:Name="TournamentCountText" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="3" Click="TournamentClose_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Выйти (Esc)">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                </Button>
            </Grid>

            <Grid x:Name="TournamentDuel" Grid.Row="1" Margin="16,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="TournamentLeft" Grid.Column="0" CornerRadius="8" Background="Transparent" BorderThickness="2"
                      Tapped="TournamentLeft_Tapped" PointerEntered="TournamentSide_PointerEntered" PointerExited="TournamentSide_PointerExited">
                    <Image x:Name="TournamentLeftImage" Stretch="Uniform" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="10,4" CornerRadius="8" Background="#99000000" IsHitTestVisible="False">
                        <TextBlock x:Name="TournamentLeftName" FontSize="12" />
                    </Border>
                </Grid>
                <Grid x:Name="TournamentRight" Grid.Column="1" CornerRadius="8" Background="Transparent" BorderThickness="2"
                      Tapped="TournamentRight_Tapped" PointerEntered="TournamentSide_PointerEntered" PointerExited="TournamentSide_PointerExited">
                    <Image x:Name="TournamentRightImage" Stretch="Uniform" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="10,4" CornerRadius="8" Background="#99000000" IsHitTestVisible="False">
                        <TextBlock x:Name="TournamentRightName" FontSize="12" />
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="TournamentResult" Grid.Row="1" Visibility="Collapsed" Padding="24,0">
                <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="1400">
                    <TextBlock x:Name="TournamentResultTitle" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <ItemsControl x:Name="TournamentWinners">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="236" ItemHeight="200" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="Поставить им суперлайк" Style="{StaticResource AccentButtonStyle}" Click="TournamentSuperLike_Click" />
                        <Button Content="Скопировать все" Click="TournamentCopy_Click" ToolTipService.ToolTip="В буфер обмена как файлы: вставить в папку или в Instagram через браузер" />
                        <Button Content="Сравнить" Click="TournamentCompare_Click" />
                        <Button Content="Показать в галерее" Click="TournamentShow_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="TournamentHint" Grid.Row="2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16,8,16,14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="← или 1 — левое лучше  ·  → или 2 — правое лучше  ·  клик по фото тоже выбирает  ·  Backspace назад  ·  Esc выйти" />
        </Grid>

        <!-- Editor: crop for Instagram and a few sliders. The photo itself is never changed. -->
        <Grid x:Name="EditorView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource LoupeBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="EditorStage" Grid.Column="0" Margin="24" Background="Transparent" SizeChanged="EditorStage_SizeChanged"
                  PointerPressed="EditorStage_PointerPressed" PointerMoved="EditorStage_PointerMoved"
                  PointerReleased="EditorStage_PointerReleased" PointerCaptureLost="EditorStage_PointerCaptureLost">
                <Image x:Name="EditorImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" SizeChanged="EditorImage_SizeChanged" />
                <Canvas x:Name="EditorOverlay" IsHitTestVisible="False">
                    <Path x:Name="EditorShade" Fill="#AA000000">
                        <Path.Data>
                            <GeometryGroup FillRule="EvenOdd">
                                <RectangleGeometry x:Name="EditorShadeOuter" />
                                <RectangleGeometry x:Name="EditorShadeInner" />
                            </GeometryGroup>
                        </Path.Data>
                    </Path>
                    <Line x:Name="EditorThird1" Stroke="#66FFFFFF" StrokeThickness="1" />
                    <Line x:Name="EditorThird2" Stroke="#66FFFFFF" StrokeThickness="1" />
                    <Line x:Name="EditorThird3" Stroke="#66FFFFFF" StrokeThickness="1" />
                    <Line x:Name="EditorThird4" Stroke="#66FFFFFF" StrokeThickness="1" />
                    <Rectangle x:Name="EditorFrame" Stroke="White" StrokeThickness="1.5" />
                    <Rectangle x:Name="EditorHandleTL" Width="14" Height="14" Fill="White" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="EditorHandleTR" Width="14" Height="14" Fill="White" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="EditorHandleBL" Width="14" Height="14" Fill="White" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="EditorHandleBR" Width="14" Height="14" Fill="White" RadiusX="2" RadiusY="2" />
                </Canvas>
                <ProgressRing x:Name="EditorLoading" IsActive="False" Width="48" Height="48" />
                <Border x:Name="EditorBeforeBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="10,4" CornerRadius="8"
                        Background="#CC000000" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="До правок" FontSize="12" />
                </Border>
            </Grid>

            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Padding="20,16,20,8" Spacing="2">
                    <TextBlock Text="Кроп и цвет" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="EditorName" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" Padding="20,0">
                    <StackPanel Spacing="14" Padding="0,8,0,16">
                        <TextBlock Text="Кадр" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <GridView x:Name="EditorAspects" SelectionMode="Single" SelectionChanged="EditorAspects_SelectionChanged" IsItemClickEnabled="False" Margin="-4,0,0,0">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="4" />
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                        <TextBlock x:Name="EditorCropInfo" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="EditorSliders" Spacing="4" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Сбросить всё" Click="EditorReset_Click" />
                            <ToggleButton x:Name="EditorBeforeButton" Content="До / после" Click="EditorBefore_Click" ToolTipService.ToolTip="Показать фото без правок (\)" />
                        </StackPanel>
                        <Button Content="Вставить цвет из скопированного" x:Name="EditorPasteButton" Click="EditorPaste_Click" Visibility="Collapsed" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                   Text="Перетащи рамку, чтобы сдвинуть кадр, а угол — чтобы изменить размер. Двойной клик по ползунку сбрасывает его. Оригинал не меняется: правки хранятся в Lumy, а для RAW ещё и в .xmp для Lightroom." />
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2" Padding="20,12,20,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Отмена" HorizontalAlignment="Stretch" Click="EditorCancel_Click" ToolTipService.ToolTip="Esc" />
                    <Button Grid.Column="1" Content="Экспорт…" HorizontalAlignment="Stretch" Click="EditorExport_Click" ToolTipService.ToolTip="Сохранить и выгрузить JPEG (Ctrl+E)" />
                    <Button Grid.Column="2" Content="Готово" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="EditorDone_Click" ToolTipService.ToolTip="Сохранить правки (Enter)" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Toast for short confirmations ("Автопереход выключен", "Не удалось записать XMP"). -->
        <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                Padding="16,10" CornerRadius="8" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Border.OpacityTransition>
            <TextBlock x:Name="ToastText" />
        </Border>
    </Grid>
</Window>
