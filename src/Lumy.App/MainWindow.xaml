<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lumy.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lumy.App"
    Title="Lumy">

    <Grid x:Name="RootGrid" PreviewKeyDown="RootGrid_PreviewKeyDown" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the window draws its own so the app reads as one surface on Mica. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEB9F;" FontSize="16" Foreground="{StaticResource SuperLikeBrush}" />
                <TextBlock Text="Lumy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="FolderTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="1" Padding="12,4,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OpenFolder_Click" ToolTipService.ToolTip="Открыть папку (Ctrl+O)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                    <TextBlock Text="Открыть папку" />
                </StackPanel>
            </Button>

            <SelectorBar x:Name="FilterBar" Grid.Column="1" SelectionChanged="FilterBar_SelectionChanged">
                <SelectorBarItem Text="Все" Tag="All" IsSelected="True" ToolTipService.ToolTip="Ctrl+0" />
                <SelectorBarItem Text="Лайки" Tag="LikedOrBetter" ToolTipService.ToolTip="Лайки и суперлайки (Ctrl+1)" />
                <SelectorBarItem Text="Суперлайки" Tag="SuperLikes" ToolTipService.ToolTip="Ctrl+2" />
                <SelectorBarItem Text="Без оценки" Tag="Unrated" ToolTipService.ToolTip="Ctrl+3" />
                <SelectorBarItem Text="Отклонённые" Tag="Rejected" ToolTipService.ToolTip="Ctrl+4" />
            </SelectorBar>

            <ComboBox x:Name="SortBox" Grid.Column="2" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" MinWidth="170">
                <ComboBoxItem Content="По времени съёмки" Tag="CaptureTime" />
                <ComboBoxItem Content="По имени" Tag="Name" />
            </ComboBox>

            <TextBlock x:Name="CounterText" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTipService.ToolTip="Размер миниатюр (Ctrl + колесо)">
                <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Slider x:Name="SizeSlider" Width="140" Minimum="120" Maximum="420" StepFrequency="10" ValueChanged="SizeSlider_ValueChanged" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="5" Click="Remote_Click" ToolTipService.ToolTip="Пульт: управлять Lumy с телефона">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8EA;" FontSize="16" />
                    <TextBlock x:Name="RemoteButtonText" Text="Телефон" />
                </StackPanel>
            </Button>

            <Button Grid.Column="6" Click="Help_Click" ToolTipService.ToolTip="Клавиши (?)">
                <FontIcon Glyph="&#xE765;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Gallery -->
        <Grid Grid.Row="2">
            <GridView
                x:Name="Gallery"
                Padding="12,0,12,12"
                SelectionMode="Extended"
                IsItemClickEnabled="False"
                ContainerContentChanging="Gallery_ContainerContentChanging"
                DoubleTapped="Gallery_DoubleTapped"
                PointerWheelChanged="Gallery_PointerWheelChanged"
                ContextRequested="Gallery_ContextRequested">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="200" ItemHeight="200" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:PhotoItem">
                        <Grid CornerRadius="6" Margin="3" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              ToolTipService.ToolTip="{x:Bind FileName}">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" Opacity="{x:Bind ImageOpacity, Mode=OneWay}" />
                            <Border Visibility="{x:Bind TierBadgeVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                    Padding="5" CornerRadius="12" Background="#99000000">
                                <FontIcon Glyph="{x:Bind TierGlyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind TierBrush, Mode=OneWay}" />
                            </Border>
                            <Border Visibility="{x:Bind SeriesBadgeVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                    Padding="6,2" CornerRadius="8" Background="#99000000"
                                    ToolTipService.ToolTip="Серия похожих кадров">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="11" />
                                    <TextBlock Text="{x:Bind SeriesBadgeText, Mode=OneWay}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE91B;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Откройте папку с фотосессией" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Ctrl+O или перетащите папку в окно" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <Button Content="Открыть папку" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OpenFolder_Click" />
            </StackPanel>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="48" Height="48" />
        </Grid>

        <!-- Full-screen viewer, drawn over everything below the title bar: info bar, photo, filmstrip. -->
        <Grid x:Name="Loupe" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource LoupeBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar: rating buttons, name, shooting details, position -->
            <Grid Grid.Row="0" Padding="12,6,16,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="LoupeRejectButton" Click="LoupeReject_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Отказ (X). Ещё раз, чтобы снять">
                        <FontIcon x:Name="LoupeRejectIcon" Glyph="&#xE711;" FontSize="18" />
                    </Button>
                    <Button x:Name="LoupeLikeButton" Click="LoupeLike_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Лайк (F или 1). Ещё раз, чтобы снять">
                        <FontIcon x:Name="LoupeLikeIcon" Glyph="&#xEB51;" FontSize="18" />
                    </Button>
                    <Button x:Name="LoupeSuperButton" Click="LoupeSuper_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Суперлайк (R или 2). Ещё раз, чтобы снять">
                        <FontIcon x:Name="LoupeSuperIcon" Glyph="&#xE734;" FontSize="18" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="LoupeName" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="LoupeDetails" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LoupePosition" Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                    <Button Click="FilmstripToggle_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Показать или скрыть ленту (T)">
                        <FontIcon x:Name="FilmstripToggleIcon" Glyph="&#xE70D;" FontSize="14" />
                    </Button>
                    <Button Click="LoupeMore_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="Ещё: копировать, показать в проводнике, открыть в…">
                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                    </Button>
                    <Button Click="LoupeClose_Click" Style="{StaticResource LoupeIconButtonStyle}" ToolTipService.ToolTip="В галерею (Esc)">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The photo: centred, fitted to the space between the bars; Ctrl + wheel or Z zooms, drag pans. -->
            <ScrollViewer
                x:Name="LoupeScroll"
                Grid.Row="1"
                ZoomMode="Enabled"
                MinZoomFactor="1"
                MaxZoomFactor="16"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Hidden"
                SizeChanged="LoupeScroll_SizeChanged"
                DoubleTapped="LoupeScroll_DoubleTapped"
                ContextRequested="LoupeScroll_ContextRequested">
                <Grid x:Name="LoupeCanvas" Background="Transparent">
                    <Image x:Name="LoupeImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </ScrollViewer>

            <!-- Flash shown for a moment after rating, so a key press visibly lands. -->
            <Border x:Name="FlashBadge" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" CornerRadius="60"
                    Background="#88000000" Opacity="0" IsHitTestVisible="False">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.18" />
                </Border.OpacityTransition>
                <FontIcon x:Name="FlashIcon" FontSize="64" />
            </Border>

            <!-- Filmstrip: the wheel over it scrolls the strip only; a click opens that photo. -->
            <Grid x:Name="FilmstripPanel" Grid.Row="2" Background="#FF111113">
                <ListView
                    x:Name="Filmstrip"
                    Height="96"
                    Padding="8,6"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="Filmstrip_ItemClick"
                    ContainerContentChanging="Filmstrip_ContainerContentChanging"
                    ContextRequested="Filmstrip_ContextRequested"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.IsHorizontalRailEnabled="True">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PhotoItem">
                            <Grid Width="{StaticResource FilmstripItemWidth}" Height="80" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" Opacity="{x:Bind ImageOpacity, Mode=OneWay}" />
                                <Border Visibility="{x:Bind TierBadgeVisibility, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="3" Padding="3" CornerRadius="8" Background="#99000000">
                                    <FontIcon Glyph="{x:Bind TierGlyph, Mode=OneWay}" FontSize="10" Foreground="{x:Bind TierBrush, Mode=OneWay}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Swipe mode: one card at a time, a decision per card. -->
        <Grid x:Name="SwipeView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource LoupeBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="20,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Свайп" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar x:Name="SwipeProgressBar" Grid.Column="1" VerticalAlignment="Center" Minimum="0" />
                <TextBlock x:Name="SwipeProgressText" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <Grid x:Name="SwipeStage" Grid.Row="1" Margin="24,0">
                <Image x:Name="SwipeNextImage" Stretch="Uniform" Opacity="0.35" />
                <Grid x:Name="SwipeCard" Background="Transparent" RenderTransformOrigin="0.5,0.5"
                      ManipulationMode="TranslateX,TranslateY"
                      ManipulationDelta="SwipeCard_ManipulationDelta"
                      ManipulationCompleted="SwipeCard_ManipulationCompleted">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="SwipeTransform" />
                    </Grid.RenderTransform>
                    <Image x:Name="SwipeImage" Stretch="Uniform" />
                    <Border x:Name="SwipeHint" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" CornerRadius="60"
                            Background="#88000000" Opacity="0" IsHitTestVisible="False">
                        <FontIcon x:Name="SwipeHintIcon" FontSize="72" />
                    </Border>
                </Grid>
                <TextBlock x:Name="SwipeSeriesText" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel x:Name="SwipeSummary" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <TextBlock Text="Готово" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SwipeSummaryText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="Ещё раз по лайкам" Click="SwipeAgainLikes_Click" />
                        <Button Content="Показать лайки" Click="SwipeShowLikes_Click" />
                        <Button Content="В галерею" Style="{StaticResource AccentButtonStyle}" Click="SwipeClose_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,12,0,20">
                <Button Click="SwipeBack_Click" ToolTipService.ToolTip="Назад (Backspace)" Width="48" Height="48" CornerRadius="24">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                </Button>
                <Button Click="SwipeReject_Click" ToolTipService.ToolTip="Отказ (←), Shift+← вся серия" Width="64" Height="64" CornerRadius="32">
                    <FontIcon Glyph="&#xE711;" FontSize="22" Foreground="{StaticResource RejectBrush}" />
                </Button>
                <Button Click="SwipeSkip_Click" ToolTipService.ToolTip="Решу потом (↓)" Width="48" Height="48" CornerRadius="24">
                    <FontIcon Glyph="&#xE74B;" FontSize="16" />
                </Button>
                <Button Click="SwipeSuper_Click" ToolTipService.ToolTip="Суперлайк (↑)" Width="64" Height="64" CornerRadius="32">
                    <FontIcon Glyph="&#xE735;" FontSize="22" Foreground="{StaticResource SuperLikeBrush}" />
                </Button>
                <Button Click="SwipeLike_Click" ToolTipService.ToolTip="Лайк (→)" Width="64" Height="64" CornerRadius="32">
                    <FontIcon Glyph="&#xEB52;" FontSize="22" Foreground="{StaticResource LikeBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Compare: 2 to 9 photos side by side, zoom and pan in sync. -->
        <Grid x:Name="CompareView" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="{StaticResource LoupeBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="20,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Сравнение" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="CompareInfo" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Grid x:Name="CompareGrid" Grid.Row="1" Margin="8,0" SizeChanged="CompareGrid_SizeChanged" />
            <TextBlock Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,14" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="Наведи на фото: F лайк  ·  R суперлайк  ·  X отказ  ·  1–9 убрать из сравнения  ·  Ctrl+колесо зум  ·  L синхронизация  ·  Esc назад" />
        </Grid>

        <!-- Toast for short confirmations ("Автопереход выключен", "Не удалось записать XMP"). -->
        <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                Padding="16,10" CornerRadius="8" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Border.OpacityTransition>
            <TextBlock x:Name="ToastText" />
        </Border>
    </Grid>
</Window>
